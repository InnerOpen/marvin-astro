---
/**
 * Embed — render a Marvin `PublishedEmbed` from its structured fields.
 *
 * - `status: 'ok'` with an allowed iframe → the player (`mode="direct"`) or a click-to-load facade
 *   (`mode="click_to_load"`, the default: nothing loads from the provider until the visitor clicks).
 * - anything else → a plain link card.
 *
 * The markup matches the `html` Marvin publishes for the same embed and mode, so either renders
 * the same with the same CSS. Use it for `embed` fields (`f.embed('video')`); markdown bodies
 * already carry Marvin's `html`. Facades need `<EmbedLoader />` once in the layout.
 */
import type { MarvinEmbed, MarvinEmbedMode } from '../embeds.js';
import { frameHostPattern, iframeAttributes, isAllowedFrameSrc, safeLinkHref } from './embed-frame.js';
import LinkCard from './LinkCard.astro';

interface Props {
  embed: MarvinEmbed | null | undefined;
  /** `site.embeds.mode`. Default `click_to_load`. */
  mode?: MarvinEmbedMode;
  /** `site.embeds.consentText`, shown on the facade. `{provider}` becomes the provider name. */
  consentText?: string | null;
  /** `site.embeds.frameSources`. When given, an iframe outside them renders as a link card. */
  frameSources?: string[] | null;
  class?: string;
}

/** Marvin's default, for a server that doesn't send `site.embeds`. */
const DEFAULT_CONSENT_TEXT = 'Loading this player connects to {provider}, which may set cookies.';

const { embed, mode = 'click_to_load', consentText, frameSources, class: className } = Astro.props;

const iframe = embed?.status === 'ok' ? (embed.iframe ?? undefined) : undefined;
const providerName = embed?.providerName || embed?.link?.providerName || 'the provider';

// A facade may load only the iframe's own host — the narrowest list, like Marvin's own facades.
const ownHost = iframe ? hostOf(iframe.src) : undefined;
const hosts = ownHost ? [ownHost] : [];
const withinFrameSources = !frameSources?.length || isAllowedFrameSrc(iframe?.src, frameSources);
const attributes =
  iframe && withinFrameSources
    ? iframeAttributes(
        {
          src: iframe.src,
          title: iframe.title || embed?.title || `${providerName} player`,
          allow: iframe.allow,
          sandbox: iframe.sandbox,
          referrerpolicy: iframe.referrerpolicy || 'strict-origin-when-cross-origin',
          loading: 'lazy',
        },
        hosts
      )
    : undefined;

function hostOf(src: unknown): string | undefined {
  if (typeof src !== 'string') return undefined;
  try {
    return frameHostPattern(new URL(src).hostname);
  } catch {
    return undefined;
  }
}

// Size travels as a CSS custom property on the figure: a fixed height (audio, podcast, playlist)
// or an aspect ratio (video; 9/16 for Shorts). Validated, never passed through raw.
function sizeStyle(): string | undefined {
  const height = iframe?.height;
  if (typeof height === 'number' && Number.isInteger(height) && height > 0 && height < 5000) {
    return `--marvin-embed-height:${height}px`;
  }
  const aspect = iframe?.aspectRatio;
  if (typeof aspect === 'string' && /^\d{1,3}\/\d{1,3}$/.test(aspect)) {
    return `--marvin-embed-aspect:${aspect}`;
  }
  return undefined;
}

const kind = embed ? String(embed.kind).replace(/[^a-z0-9-]/gi, '') || 'video' : 'video';
const linkTitle = embed?.link?.title || embed?.title || providerName;
const label = embed?.title || linkTitle;
const consent = (consentText || DEFAULT_CONSENT_TEXT).replaceAll('{provider}', providerName);
const linkHref = safeLinkHref(embed?.link?.href ?? embed?.canonicalUrl ?? embed?.url);
const classes = (...names: (string | false | undefined)[]) => names.filter(Boolean).join(' ');
---

{embed && attributes && mode === 'direct' && (
  <figure
    class={classes('marvin-embed', `marvin-embed--${kind}`, className)}
    data-provider={embed.provider}
    style={sizeStyle()}
  >
    <iframe {...attributes} />
  </figure>
)}

{embed && attributes && mode !== 'direct' && (
  <figure
    class={classes('marvin-embed', `marvin-embed--${kind}`, 'marvin-embed--facade', className)}
    data-provider={embed.provider}
    style={sizeStyle()}
  >
    <button
      type="button"
      class="marvin-embed__load"
      data-marvin-embed-src={attributes.src}
      data-marvin-embed-attrs={JSON.stringify(attributes)}
      data-marvin-embed-hosts={JSON.stringify(hosts)}
    >
      <span class="marvin-embed__provider">{providerName}</span>
      <span class="marvin-embed__title">{label}</span>
      <span class="marvin-embed__consent">{consent}</span>
    </button>
    {linkHref && (
      <a class="marvin-embed__link" href={linkHref} rel="noopener noreferrer">{linkTitle}</a>
    )}
  </figure>
)}

{embed && !attributes && <LinkCard embed={embed} class={className} />}
