---
/**
 * FormRenderer — render a public form from a submittable entry type's field schema.
 *
 * A submittable entry type IS a form; its `schema_json.fields` ARE the form fields. Fetch the
 * definition from the Marvin publishing API at build time — `GET /publish/{ws}/forms/{slug}`
 * returns `{ formSchema: { fields }, metadata: { successMessage, honeypotField, captcha } }` — and pass it
 * here. The form then renders from the same schema the submission validates against, so a form no
 * longer has to be hand-coded per page or per site.
 *
 * Intentionally UNSTYLED (semantic markup + `data-*` hooks) so the consuming site owns the look;
 * the only inline style is the visually-hidden honeypot trap.
 */
export interface FormFieldSchema {
  key: string;
  label: string;
  /** text | textarea | select | number | boolean | date | datetime (others render as text). */
  type: string;
  required?: boolean;
  placeholder?: string;
  helpText?: string;
  defaultValue?: unknown;
  options?: string[]; // select
  rows?: number; // textarea
  min?: number;
  max?: number;
  step?: number;
  pattern?: string; // text
  format?: string; // 'email' | 'tel' | 'url' — hints the input type
}

/**
 * The CAPTCHA widget to show. `appearance`, `theme` and `size` are Turnstile's own options, passed through as it names them
 * (the widget is drawn inside the provider's iframe, so these are the only looks it offers): `appearance: 'interaction-only'`
 * shows the box only to a visitor who has to do something (most never see it); `theme` is `auto`, `light` or `dark`; `size` is
 * `normal`, `flexible` (fills the form's width) or `compact`. They apply to Turnstile only.
 */
export interface CaptchaWidget {
  provider: string;
  siteKey: string;
  appearance?: 'always' | 'execute' | 'interaction-only';
  theme?: 'auto' | 'light' | 'dark';
  size?: 'normal' | 'flexible' | 'compact';
}

export interface Props {
  /** The entry type's field schema (`formSchema` from the publishing API). */
  schema: { fields: FormFieldSchema[] } | null | undefined;
  /** Where the form POSTs, e.g. `/api/forms/inquiry`. */
  action: string;
  /** Hidden anti-spam field name; omit to skip the honeypot. */
  honeypotField?: string;
  /**
   * The CAPTCHA widget to show (`metadata.captcha` from the publishing API: set when the form's CAPTCHA is on in
   * Marvin and has a site key). `turnstile` and `hcaptcha` are drawn; the widget's answer is sent as `captchaToken`,
   * which Marvin checks. Omit, or pass a provider this component doesn't know, and no widget is shown.
   */
  captcha?: CaptchaWidget | null;
  /** Message shown after a successful (JS) submit. */
  successMessage?: string;
  /** Submit button label. */
  submitLabel?: string;
  class?: string;
}

const {
  schema,
  action,
  honeypotField,
  captcha,
  successMessage = 'Thank you for your submission.',
  submitLabel = 'Send',
  class: className,
} = Astro.props;

const fields = schema?.fields ?? [];

// The provider's own widget: the element it fills and the script that fills it. Both put their answer in a hidden
// input inside the form (Turnstile under the name asked for here, hCaptcha under its own, renamed on submit).
const WIDGETS: Record<string, { className: string; script: string }> = {
  turnstile: { className: 'cf-turnstile', script: 'https://challenges.cloudflare.com/turnstile/v0/api.js' },
  hcaptcha: { className: 'h-captcha', script: 'https://js.hcaptcha.com/1/api.js' },
};
const widget = captcha?.siteKey ? WIDGETS[captcha.provider] : undefined;

// A text field's input type — inferred from an explicit format hint or the field key.
function textInputType(f: FormFieldSchema): string {
  if (f.format === 'email' || f.key === 'email') return 'email';
  if (f.format === 'tel' || /phone|tel/i.test(f.key)) return 'tel';
  if (f.format === 'url' || f.key === 'url') return 'url';
  return 'text';
}
---

{fields.length > 0 && (
  <form
    method="post"
    action={action}
    data-marvin-form
    data-success={successMessage}
    class={className}
  >
    {honeypotField && (
      <input
        type="text"
        name={honeypotField}
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0"
      />
    )}

    {fields.map((f) => (
      <div class="marvin-field" data-field-type={f.type}>
        {f.type !== 'boolean' && (
          <label for={`mf-${f.key}`}>
            {f.label}
            {f.required && <span aria-hidden="true"> *</span>}
          </label>
        )}

        {(f.type === 'text' || f.type === 'number' || f.type === 'date' || f.type === 'datetime') && (
          <input
            id={`mf-${f.key}`}
            name={f.key}
            type={
              f.type === 'number'
                ? 'number'
                : f.type === 'date'
                  ? 'date'
                  : f.type === 'datetime'
                    ? 'datetime-local'
                    : textInputType(f)
            }
            required={f.required}
            placeholder={f.placeholder}
            value={f.defaultValue as string | undefined}
            min={f.min}
            max={f.max}
            step={f.step}
            pattern={f.pattern}
          />
        )}

        {f.type === 'textarea' && (
          <textarea id={`mf-${f.key}`} name={f.key} required={f.required} placeholder={f.placeholder} rows={f.rows ?? 4}>
            {f.defaultValue as string | undefined}
          </textarea>
        )}

        {f.type === 'select' && (
          <select id={`mf-${f.key}`} name={f.key} required={f.required}>
            {!f.required && <option value="">{f.placeholder ?? 'Select…'}</option>}
            {(f.options ?? []).map((o) => (
              <option value={o} selected={f.defaultValue === o}>
                {o}
              </option>
            ))}
          </select>
        )}

        {f.type === 'boolean' && (
          <label class="marvin-check" for={`mf-${f.key}`}>
            <input id={`mf-${f.key}`} name={f.key} type="checkbox" value="true" required={f.required} />
            <span>{f.label}</span>
          </label>
        )}

        {f.helpText && <p class="marvin-help">{f.helpText}</p>}
      </div>
    ))}

    {widget && (
      <div
        class={widget.className}
        data-marvin-captcha={captcha?.provider}
        data-sitekey={captcha?.siteKey}
        data-response-field-name="captchaToken"
        data-appearance={captcha?.provider === 'turnstile' ? captcha.appearance : undefined}
        data-theme={captcha?.provider === 'turnstile' ? captcha.theme : undefined}
        data-size={captcha?.provider === 'turnstile' ? captcha.size : undefined}
      />
    )}

    <button type="submit">{submitLabel}</button>
    <p data-marvin-status role="status" aria-live="polite" hidden></p>
  </form>
)}

{fields.length > 0 && widget && <script is:inline src={widget.script} async defer></script>}

<script>
  // Progressive enhancement: submit via fetch and show a status message. The native POST is the
  // no-JS fallback, so the form works either way.
  const forms = document.querySelectorAll<HTMLFormElement>('form[data-marvin-form]');
  for (const form of forms) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-marvin-status]');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const data: Record<string, unknown> = {};
      for (const [key, value] of new FormData(form).entries()) {
        data[key] = value;
      }
      // A CAPTCHA widget's answer goes up as `captchaToken` whichever provider drew it; its own field names stay home.
      const captcha = form.querySelector<HTMLElement>('[data-marvin-captcha]');
      if (captcha) {
        if (!data.captchaToken && data['h-captcha-response']) data.captchaToken = data['h-captcha-response'];
        for (const name of ['h-captcha-response', 'g-recaptcha-response', 'cf-turnstile-response']) delete data[name];
        if (!data.captchaToken) {
          if (status) {
            status.hidden = false;
            status.textContent = 'One moment: the spam check has not finished. Please try again.';
          }
          return;
        }
      }
      if (button) button.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const body = await res.json().catch(() => ({ success: res.ok }));
        if (status) {
          status.hidden = false;
          status.textContent = body.success
            ? form.dataset.success || 'Thank you.'
            : body.message || 'Something went wrong. Please try again.';
        }
        if (body.success) form.reset();
      } catch {
        if (status) {
          status.hidden = false;
          status.textContent = 'Could not send just now — please try again.';
        }
      } finally {
        if (button) button.disabled = false;
        // An answer is good for one submission: ask the widget for a fresh one, sent or not.
        if (captcha) {
          const api = (window as unknown as Record<string, { reset?: (el?: Element) => void } | undefined>)[
            captcha.dataset.marvinCaptcha === 'hcaptcha' ? 'hcaptcha' : 'turnstile'
          ];
          try {
            if (captcha.dataset.marvinCaptcha === 'hcaptcha') api?.reset?.();
            else api?.reset?.(captcha);
          } catch {
            /* the widget script has not loaded: nothing to reset */
          }
        }
      }
    });
  }
</script>
